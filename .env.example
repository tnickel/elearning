# Database Configuration
DATABASE_URL=postgres://postgres:postgres@localhost:5439/elearning

# Server Configuration
PORT=3010
JWT_SECRET=replace_with_a_secure_random_jwt_secret_in_production
JWT_ISSUER=elearning-platform
JWT_AUDIENCE=elearning-students

# Local demo: only these emails may log in as admin (comma-separated)
ADMIN_EMAILS=admin@tenant-alpha.com

# Temporal Configuration
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_QUEUE=elearning-tasks

# HeyGen API & Webhooks
HEYGEN_API_URL=https://api.heygen.com
HEYGEN_API_KEY=mock-heygen-key
WEBHOOK_SECRET=replace_with_a_secure_random_webhook_secret
WEBHOOK_URL=http://localhost:3010/api/webhooks/heygen

# ElevenLabs configuration
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM  # Default Rachel voice, or custom voice ID

# MiniMax Audio configuration
MINIMAX_API_KEY=your-minimax-api-key-here
MINIMAX_GROUP_ID=your-minimax-group-id-here
MINIMAX_VOICE_ID=male-qn-qingse  # or female-shaonv, male-qn-badao, etc.
MINIMAX_MODEL=speech-02-hd  # speech-02-hd (quality) or speech-02-turbo (fast/cheap)

# Media Generation Config
GENERATE_VIDEO=false        # set to true to enable avatar videos, false for audio-only
VIDEO_PROVIDER=elevenlabs   # elevenlabs or heygen
ELEVENLABS_TTS_ONLY=true    # set to true for default speech audio
TTS_PROVIDER=elevenlabs      # elevenlabs or minimax

# AI Service Configuration (Python FastAPI)
AI_SERVICE_URL=http://localhost:8085
LLM_PROVIDER=glm  # glm, gemini (openrouter), or vllm
EMBEDDING_PROVIDER=local  # local, glm (zhipu), or openrouter

# LLM 1: GLM / Z.ai Configuration
GLM_API_KEY=your-glm-api-key-here
GLM_MODEL=glm-5.3
GLM_VISION_MODEL=glm-5.3-flash
# Coding Plan Abo-Keys: https://api.z.ai/api/coding/paas/v4/
# Pay-as-you-go Guthaben-Keys: https://api.z.ai/api/paas/v4/
GLM_BASE_URL=https://api.z.ai/api/coding/paas/v4/
ZHIPU_API_KEY=your-glm-api-key-here  # alias for backward compatibility

# LLM 2: OpenRouter / Gemini Configuration
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=google/gemini-2.5-pro  # or meta-llama/llama-3-8b-instruct

# Local / Alternative Models
vLLM_BASE_URL=http://localhost:8000/v1
vLLM_MODEL=meta-llama/Meta-Llama-3-8B-Instruct

