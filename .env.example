# Database Configuration
DATABASE_URL=postgres://postgres:postgres@localhost:5439/elearning

# Server Configuration
PORT=3010
JWT_SECRET=supersecretjwtkeyforauthentication123!
JWT_ISSUER=elearning-platform
JWT_AUDIENCE=elearning-students

# Temporal Configuration
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_QUEUE=elearning-tasks

# HeyGen API & Webhooks
HEYGEN_API_URL=https://api.heygen.com
HEYGEN_API_KEY=mock-heygen-key
WEBHOOK_SECRET=heygen-webhook-secret-key-12345
WEBHOOK_URL=http://localhost:3010/api/webhooks/heygen

# ElevenLabs configuration
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM  # Default Rachel voice, or custom voice ID

# Media Generation Config
GENERATE_VIDEO=false        # set to true to enable avatar videos, false for audio-only
VIDEO_PROVIDER=elevenlabs   # elevenlabs or heygen
ELEVENLABS_TTS_ONLY=true    # set to true for default speech audio

# AI Service Configuration (Python FastAPI)
AI_SERVICE_URL=http://localhost:8000
LLM_PROVIDER=openrouter  # or vllm
EMBEDDING_PROVIDER=openrouter  # or local

# API Keys
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=google/gemini-2.5-pro  # or meta-llama/llama-3-8b-instruct
vLLM_BASE_URL=http://localhost:8000/v1
vLLM_MODEL=meta-llama/Meta-Llama-3-8B-Instruct
